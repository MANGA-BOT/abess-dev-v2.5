<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Material Design 3 -->
    <style name="Base.Theme.ENSPY" parent="Theme.Material3.Light.NoActionBar">
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        
        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/enspy_orange</item>
        <item name="android:navigationBarColor">@color/enspy_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Window & Background -->
        <item name="android:windowBackground">@color/enspy_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
        
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/enspy_orange</item>
        <item name="colorSecondary">@color/enspy_orange_dark</item>
        <item name="colorTertiary">@color/enspy_whatsapp</item>
        
        <!-- Surface -->
        <item name="colorSurface">@color/enspy_surface</item>
        <item name="colorBackground">@color/enspy_background</item>
        
        <!-- Material Components Styling -->
        <item name="materialButtonStyle">@style/Widget.ENSPY.Button.Filled</item>
        <item name="textAppearanceHeadline1">@style/TextAppearance.ENSPY.Headline1</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.ENSPY.Headline6</item>
        <item name="textAppearanceBody1">@style/TextAppearance.ENSPY.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.ENSPY.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.ENSPY.Caption</item>
    </style>

    <style name="Theme.ENSPY" parent="Base.Theme.ENSPY" />

    <!-- BUTTON STYLES -->
    <style name="Widget.ENSPY.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/enspy_text_inverse</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="Widget.ENSPY.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/enspy_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/enspy_orange</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.ENSPY.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/enspy_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- CARD STYLES -->
    <style name="Widget.ENSPY.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="Widget.ENSPY.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/enspy_line</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- TEXT STYLES -->
    <style name="TextAppearance.ENSPY.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/enspy_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
    </style>

    <style name="TextAppearance.ENSPY.Headline6" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/enspy_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.ENSPY.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/enspy_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.ENSPY.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/enspy_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.ENSPY.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/enspy_text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.ENSPY.Subtitle1">
        <item name="android:textColor">@color/enspy_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
    </style>

    <!-- CHIP STYLES -->
    <style name="Widget.ENSPY.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="cornerRadius">8dp</item>
        <item name="chipStrokeColor">@color/enspy_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/enspy_text_primary</item>
    </style>

    <!-- INPUT FIELD STYLES -->
    <style name="Widget.ENSPY.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/enspy_line</item>
    </style>

    <!-- DIVIDER STYLE -->
    <style name="Widget.ENSPY.Divider">
        <item name="android:background">@color/enspy_line</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- APP BAR STYLES -->
    <style name="Widget.ENSPY.AppBarLayout" parent="Widget.Material3.AppBarLayout.Primary">
        <item name="android:background">@color/enspy_orange</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="Widget.ENSPY.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/enspy_orange</item>
        <item name="titleTextColor">@color/enspy_text_inverse</item>
    </style>

    <!-- NAVIGATION STYLES -->
    <style name="Widget.ENSPY.NavigationBar" parent="Widget.Material3.NavigationBarView">
        <item name="android:background">@color/enspy_surface</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- BOTTOM SHEET STYLES -->
    <style name="Widget.ENSPY.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:colorBackground">@color/enspy_surface</item>
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet</item>
    </style>

</resources>
